# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor configuration
/.vscode/*
!/.vscode/sftp.example.json
*.sublime-workspace
*.sublime-project

# Python generated files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
dist/
build/

# Logs, caches and temporary files
*.log
*.tmp
.cache/

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.crt
sftp-config.json
sftp-config.json.bak

# ML artifacts ignored by default
*.pt
*.pth
*.onnx
*.engine
*.trt

# H618 mutable device data
/aicam_h618/var/

# Laptop datasets and training outputs
/aicam_laptop/dataset/
/aicam_laptop/line_follow/trained_line_models/
/aicam_laptop/var/

