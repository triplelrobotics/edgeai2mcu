# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor configuration
/.vscode/*
!/.vscode/sftp.example.json
*.sublime-workspace
*.sublime-project

# Python generated files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
dist/
build/

# Logs, caches and temporary files
*.log
*.tmp
.cache/

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
*.crt
sftp-config.json
sftp-config.json.bak

# ML artifacts ignored by default
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.trt

# H618 downloadable test data and mutable device data
/aicam_h618/app/classify/test_data_classification/
/aicam_h618/app/detect/test_data_detection/
/aicam_h618/app/segment/test_data_segmentation/
/aicam_h618/app/line_follow/debug_frames/
/aicam_h618/app/line_follow_2/assets/
/aicam_h618/var/

# H618 deployed models are restored and managed by Git LFS
!/aicam_h618/app/line_follow/tflite_models/
!/aicam_h618/app/line_follow/tflite_models/*.tflite

# Laptop datasets and training outputs
/aicam_laptop/dataset/
/aicam_laptop/edgeimpulse_dataset/
/aicam_laptop/line_training/trained_line_models/

# CircuitPython-generated filesystem metadata
/aicam_esp32/.Trashes/
/aicam_esp32/.fseventsd/
/aicam_esp32/.Spotlight-V100/
/aicam_esp32/.metadata_never_index
/aicam_esp32/System Volume Information/
/aicam_esp32/boot_out.txt

# CircuitPython secrets
/aicam_esp32/settings.toml
/aicam_esp32/secrets.py
